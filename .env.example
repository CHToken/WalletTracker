# Database
MONGODB_URL="mongodb+srv://user:password@cluster.mongodb.net/"

# RPC Endpoints
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
BSC_RPC_URL=https://bsc-dataseed.binance.org
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Block Explorer APIs (same key works for both)
ETHERSCAN_API_KEY="YOUR_ETHERSCAN_KEY"
BSCSCAN_API_KEY="YOUR_ETHERSCAN_KEY"

# Telegram Alerts
TELEGRAM_ACCUMULATION_BOT_TOKEN="YOUR_BOT_TOKEN"
TELEGRAM_ACCUMULATION_CHANNEL_ID="-YOUR_CHANNEL_ID"

# Moralis API (REQUIRED for Solana, RECOMMENDED for EVM)
# Free tier: 40k requests/day
# Get your key at: https://admin.moralis.io/
MORALIS_API_KEY="YOUR_MORALIS_KEY"
