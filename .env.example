# ═══════════════════════════════════════════════════════════════════════════════
#                    MULTI-RPC ARCHITECTURE - OPTIMAL SETUP
# ═══════════════════════════════════════════════════════════════════════════════
#
# RECOMMENDED ACCOUNT STRATEGY:
# ┌─────────────┬─────────────┬─────────────┬──────────────┬─────────────────────┐
# │ Provider    │ ETH         │ BSC         │ SOL          │ Create Accounts     │
# ├─────────────┼─────────────┼─────────────┼──────────────┼─────────────────────┤
# │ Alchemy     │ ✅ Primary  │ ✅ Primary  │ ✅ Primary   │ 3-4 accounts        │
# │ Ankr        │ ✅ Backup   │ ✅ Backup   │ ❌ No SOL    │ 2 accounts          │
# │ GetBlock    │ ✅ Daily    │ ✅ Daily    │ ❌ No SOL    │ 1-2 accounts        │
# │ Chainstack  │ ⚡ 1 chain  │ ⚡ 1 chain  │ ⚡ 1 chain   │ 3 accounts (1/chain)│
# │ Moralis     │ ✅ Data API │ ✅ Data API │ ✅ Data API  │ 2-3 accounts        │
# └─────────────┴─────────────┴─────────────┴──────────────┴─────────────────────┘
#
# TOTAL CAPACITY (with recommended setup):
# • ETH: ~440M requests/month
# • BSC: ~440M requests/month  
# • SOL: ~40M requests/month (Alchemy only)
# • Moralis: 120K CU/day (resets daily!)
#
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# ALCHEMY ⭐⭐⭐⭐⭐ (BEST - Primary for ALL chains)
# 30M CU/month per account | 330 req/s | WebSocket ✓ | ETH + BSC + SOL
# https://dashboard.alchemy.com/
# ─────────────────────────────────────────────────────────────────────────────
# Single key (backwards compatible):
# ALCHEMY_API_KEY="your_key"

# Multiple accounts (RECOMMENDED - comma separated):
ALCHEMY_API_KEYS="key1,key2,key3,key4"

# ─────────────────────────────────────────────────────────────────────────────
# ANKR ⭐⭐⭐⭐ (Backup for ETH + BSC - no Solana support)
# 200M credits/month per account | 30 req/s | No WebSocket
# https://www.ankr.com/rpc/
# ─────────────────────────────────────────────────────────────────────────────
# Single key:
# ANKR_API_KEY="your_key"

# Multiple accounts:
ANKR_API_KEYS="key1,key2"

# ─────────────────────────────────────────────────────────────────────────────
# GETBLOCK ⭐⭐⭐ (Daily reset - great for testing)
# 50K CU/day per account | 20 RPS | Pick 2 chains per account
# https://getblock.io/
# URL format: https://go.getblock.io/{access_token}
# ─────────────────────────────────────────────────────────────────────────────
# ETH access tokens (create ETH node in GetBlock dashboard):
# GETBLOCK_ETH_KEY="your_eth_access_token"
GETBLOCK_ETH_KEYS="token1,token2"

# BSC access tokens (create BSC node in GetBlock dashboard):
# GETBLOCK_BSC_KEY="your_bsc_access_token"  
GETBLOCK_BSC_KEYS="token1,token2"

# ─────────────────────────────────────────────────────────────────────────────
# CHAINSTACK ⭐⭐ (1 chain per FREE account - create 3 accounts)
# ~100K/day | 25 req/s | Create separate account for each chain
# https://chainstack.com/
# ─────────────────────────────────────────────────────────────────────────────
# Account 1 - ETH only:
CHAINSTACK_ETH_URL="https://ethereum-mainnet.core.chainstack.com/your_key"

# Account 2 - BSC only:
CHAINSTACK_BSC_URL="https://bsc-mainnet.core.chainstack.com/your_key"

# Account 3 - Solana only:
CHAINSTACK_SOL_URL="https://solana-mainnet.core.chainstack.com/your_key"

# ─────────────────────────────────────────────────────────────────────────────
# NOWNODES ⭐ (Trial - 1 month only, not worth multi-account)
# 100K/month | 15 RPS
# https://nownodes.io/
# ─────────────────────────────────────────────────────────────────────────────
# NOWNODES_API_KEY="your_key"

# ═══════════════════════════════════════════════════════════════════════════════
#                              DATA APIs
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# MORALIS ⭐⭐⭐⭐ (Pre-indexed data - swaps, balances, metadata)
# 40K CU/day per account (resets daily!) | ETH + BSC + SOL
# https://admin.moralis.io/
# ─────────────────────────────────────────────────────────────────────────────
# Single key:
# MORALIS_API_KEY="your_key"

# Multiple accounts (RECOMMENDED):
MORALIS_API_KEYS="key1,key2,key3"

# ─────────────────────────────────────────────────────────────────────────────
# BLOCK EXPLORERS (Transaction history, not RPC)
# ─────────────────────────────────────────────────────────────────────────────
ETHERSCAN_API_KEY="your_etherscan_key"
BSCSCAN_API_KEY="your_bscscan_key"

# ═══════════════════════════════════════════════════════════════════════════════
#                              OTHER SERVICES
# ═══════════════════════════════════════════════════════════════════════════════

# Database
MONGODB_URL="mongodb+srv://user:password@cluster.mongodb.net/"

# Telegram Alerts
TELEGRAM_ACCUMULATION_BOT_TOKEN="your_bot_token"
TELEGRAM_ACCUMULATION_CHANNEL_ID="-your_channel_id"

# ═══════════════════════════════════════════════════════════════════════════════
#                              DEBUG OPTIONS
# ═══════════════════════════════════════════════════════════════════════════════

# Enable RPC failover logging (shows which provider is being used)
# DEBUG_RPC=true
